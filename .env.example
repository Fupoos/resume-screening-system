# 应用配置
APP_NAME=简历智能初筛系统
APP_VERSION=1.0.0
DEBUG=False

# 数据库配置
DATABASE_URL=postgresql+asyncpg://resume:resume123@db:5432/resume_screening

# Redis配置
REDIS_URL=redis://redis:6379/0

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 加密配置
ENCRYPTION_KEY=your-encryption-key-32-bytes-long-change

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 邮箱配置（默认值）
DEFAULT_IMAP_SERVER=imap.exmail.qq.com
DEFAULT_IMAP_PORT=993

# Agent配置
AGENT_API_KEY=your_api_key_here
AGENT_TIMEOUT=30
AGENT_RETRY_COUNT=3
PDF_BASE_URL=http://localhost:8000

# FastGPT配置
# 统一Agent API配置
FASTGPT_API_KEY=your_fastgpt_api_key_here
FASTGPT_BASE_URL=http://localhost:3000
FASTGPT_CHAT_API=/api/v1/chat/completions
FASTGPT_TIMEOUT=120

# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai

# 邮箱监听配置
DEMO_EMAIL=your_email@example.com
DEMO_AUTH_CODE=your_auth_code
