# ===========================================
# 简历筛选系统 - 环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下方的默认值为实际值
# 3. .env 文件不会被提交到版本控制
#
# ⚠️ 安全警告（重要）：
# - 所有标记 [必须修改] 的配置项在生产环境启动前必须修改
# - docker-compose.yml 已移除默认值fallback，缺少环境变量将导致启动失败
# - 密钥长度必须符合要求（SECRET_KEY至少32字符，ENCRYPTION_KEY正好32字节）
# - 不要将 .env 文件提交到版本控制系统

# ===========================================
# 应用配置
# ===========================================
APP_NAME=简历智能初筛系统
APP_VERSION=1.0.0
# 调试模式（生产环境必须设为 False）
DEBUG=False

# ===========================================
# 数据库配置
# ===========================================
# [必须修改] 数据库密码（至少16字符，包含大小写字母、数字、特殊字符）
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://resume:${POSTGRES_PASSWORD}@db:5432/resume_screening

# ===========================================
# Redis配置
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# JWT 配置
# ===========================================
# [必须修改] JWT密钥（至少32字符，用于Token签名）
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# 加密配置
# ===========================================
# [必须修改] AES加密密钥，必须是正好32字节（用于加密邮箱授权码等敏感信息）
ENCRYPTION_KEY=your-encryption-key-exactly-32-bytes-long

# ===========================================
# CORS配置
# ===========================================
# 生产环境请修改为实际前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ===========================================
# Celery配置
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# 邮箱配置
# ===========================================
# IMAP服务器配置
DEFAULT_IMAP_SERVER=imap.exmail.qq.com
DEFAULT_IMAP_PORT=993
# [必须修改] 企业邮箱地址（用于接收简历）
DEMO_EMAIL=your_email@example.com
# [必须修改] 邮箱授权码（不是登录密码，需要在邮箱后台生成）
DEMO_AUTH_CODE=your_email_auth_code

# ===========================================
# FastGPT Agent 配置
# ===========================================
# FastGPT API 基础地址
FASTGPT_BASE_URL=https://ai.cloudpense.com/api
# [必须修改] Java开发 职位评估密钥
FASTGPT_API_KEY=your_fastgpt_api_key
# [必须修改] 研发(RD) 职位评估密钥
FASTGPT_API_KEY_RD=your_fastgpt_rd_key
# [必须修改] 医疗(Medical) 职位评估密钥
FASTGPT_API_KEY_MEDICAL=your_fastgpt_medical_key
